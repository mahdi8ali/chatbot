# Supabase Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Private
SUPABASE_SERVICE_ROLE_KEY=

# Ollama
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# API Keys (Optional: Entering an API key here overrides the API keys globally for all users.)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# OpenAI Configuration (Server-side only)
OPENAI_MODEL=gpt-4o

# ==========================================================================
# نطاقات مسموح لها باستدعاء نقاط الشات (CORS)
# --------------------------------------------------------------------------
# نطاق الموقع الأساسي — يُستعمل أيضاً في قائمة الأصول المسموح بها.
SITE_DOMAIN=https://alkafeel.net
#
# نطاقات إضافية مفصولة بفواصل. نطاقات *.alkafeel.net مسموحة تلقائياً،
# وأي منفذ localhost مسموح في التطوير فقط.
# ⚠️ إن كان الودجت مضمّناً في نطاق آخر فأضِفه هنا وإلّا حُجبت طلباته بـ 403.
# مثال: CHAT_ALLOWED_ORIGINS=https://partner.example.com,https://x.test
CHAT_ALLOWED_ORIGINS=
# ==========================================================================

# Local MySQL Database Configuration (Server-side only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db
DB_CONNECTION_LIMIT=10

# OpenAI API Information
NEXT_PUBLIC_OPENAI_ORGANIZATION_ID=

# Azure API Information
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_GPT_35_TURBO_NAME=
AZURE_GPT_45_VISION_NAME=
AZURE_GPT_45_TURBO_NAME=
AZURE_EMBEDDINGS_NAME=

# General Configuration (Optional)
EMAIL_DOMAIN_WHITELIST=
EMAIL_WHITELIST=

# File size limit for uploads in bytes
NEXT_PUBLIC_USER_FILE_SIZE_LIMIT=10485760

# ==========================================================================
# لوحة الإدارة — مصادقة الدخول والجلسة (Admin Dashboard Auth)
# --------------------------------------------------------------------------
# متغيّرات خادمية بحتة (Server-only): لا تضِف بادئة NEXT_PUBLIC_ لأيٍّ منها،
# وإلّا سُرِّبت إلى العميل. القيم أدناه أمثلة/عناصر نائبة فقط — لا تضع أسراراً حقيقية هنا.
#
# مغلق افتراضياً (Closed by default): إذا غاب أيٌّ من
# ADMIN_USERNAME أو ADMIN_PASSWORD_HASH أو ADMIN_SESSION_SECRET،
# فسيُعطَّل تسجيل الدخول للوحة الإدارة وتُرفض طلبات الـ API المحمية.
#
# HTTPS في الإنتاج: يجب تقديم التطبيق عبر HTTPS في الإنتاج، لأن كوكي الجلسة
# يستخدم السمة Secure ولن يُرسل عبر اتصال HTTP غير مؤمّن.
# ==========================================================================

# اسم المستخدم الإداري
ADMIN_USERNAME=

# ناتج scrypt بصيغة "saltHex:hashHex" — يُولَّد عبر:
#   node scripts/gen-admin-hash.mjs '<password>'
ADMIN_PASSWORD_HASH=

# سرّ عشوائي طويل (32+ بايت hex) لتوقيع الجلسة عبر HMAC — يمكن توليده عبر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ إلزامي وبطول 32 محرفاً فأكثر: عند غيابه أو قِصَره تُرفض كل جلسات الإدارة
# ويعيد مسار تسجيل الدخول 503 (مغلق افتراضياً). لا تنشر بيئة بدونه.
ADMIN_SESSION_SECRET=

# اختياري: مدة صلاحية الجلسة بالساعات (افتراضي 8)
ADMIN_SESSION_TTL_HOURS=8

# ==========================================================================
# محرّك البحث
# --------------------------------------------------------------------------
# db     (الافتراضي) — ترشيح المرشّحين في SQL ثم إعادة ترتيبهم بـ scoreItem.
#                      بلا إقلاع بارد وبلا تحميل 56,819 عنصراً في الذاكرة.
# memory — السلوك القديم: تحميل كل المصادر إلى ذاكرة العملية.
#          يُستعمل للتراجع الفوري وللمقارنة عبر `npm run eval`.
SEARCH_ENGINE=db
# ==========================================================================

# ==========================================================================
# حدّ المعدّل المشترك (مدعوم بقاعدة البيانات — يعمل عبر كل الـ instances)
# --------------------------------------------------------------------------
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_MS=60000

# حدّ اتصالات بِركة السجلّات الموحّدة (افتراضي 8)
LOGS_DB_CONNECTION_LIMIT=8
# ==========================================================================
